# ─── Client-side (exposed to browser via Vite) ───────────────────
# Base URL for the proxy API (Vite dev server forwards /api → proxy)
VITE_PROXY_BASE_URL=/api

# ─── Server-side ONLY (never exposed to browser) ─────────────────
# IOTA JSON-RPC endpoint (mainnet)
SERVER_IOTA_RPC_URL=https://api.mainnet.iota.cafe:443

# Express proxy port
SERVER_PROXY_PORT=3001

# Allowed CORS origin (set to your frontend URL in production)
SERVER_CORS_ORIGIN=http://localhost:5173

# Rate limiting: max requests per window per IP
SERVER_RATE_LIMIT_MAX=60
SERVER_RATE_LIMIT_WINDOW_MS=60000
